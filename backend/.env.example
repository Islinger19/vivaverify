# LLMs (tried in this order; a failing provider is skipped for 2 minutes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BACKUP_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Voice (real-time STT + TTS over WebSockets, browser uses short-lived keys)
SONIOX_API_KEY=
# Comma-separated list of frontend origins allowed to call the API, e.g. https://vivaverify.vercel.app
ALLOWED_ORIGINS=*
