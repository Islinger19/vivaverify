[Unit]
Description=VivaVerify backend (FastAPI + LangGraph)
After=network-online.target
Wants=network-online.target

[Service]
User=vivaverify
WorkingDirectory=/opt/vivaverify/backend
# One worker on purpose: uploaded documents and viva sessions live in memory.
ExecStart=/opt/vivaverify/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
